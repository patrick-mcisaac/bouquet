Table Flowers {
    id int [pk]
    commonName varchar
    color varchar
}

Table Nurseries {
    id int [pk]
    name varchar
}

Table FlowerRetailers {
    id int [pk]
    name varchar
    city varchar
    state varchar
    address varchar
    distributorId int [ref: - FlowerDistributors.id]
}

Table FlowerDistributors {
    id int [pk]
    name varchar
    city varchar
    state varchar
    address varchar
}

Table flowerExchanges {
    id int [pk]
    flowerId int [ref: > Flowers.id]
    nurseryId int [ref: > Nurseries.id]
    flowerDistributorId int [ref: > FlowerDistributors.id]
}